  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "angular-split": "^20.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "license": "MIT",
  "keywords": [
    "angular",
    "dock",
    "docking",
    "layout",
